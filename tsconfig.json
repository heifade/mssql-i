{
  "include": ["./src/**/*"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./es/",
    "removeComments": true,
    "types": ["node"],
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "target": "esnext",
    "module": "nodenext",
    "declaration": true,
    "resolveJsonModule": true,
    "sourceMap": true
  }
}
